{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dotnet-ai-toolkit/schemas/agent-frontmatter.schema.json",
  "title": "Agent Frontmatter",
  "type": "object",
  "required": ["id", "title", "category", "domains", "skills_default"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^agent\\.[a-z0-9-]+$",
      "description": "e.g. agent.code-reviewer"
    },
    "title": { "type": "string", "minLength": 1 },
    "category": { "const": "agent" },
    "domains": {
      "type": "array",
      "items": { "enum": ["dotnet", "agentic-ai"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "skills_default": {
      "type": "array",
      "items": { "type": "string" }
    },
    "escalates_to": {
      "type": "array",
      "items": { "type": "string", "pattern": "^agent\\.[a-z0-9-]+$" },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
